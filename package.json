{
  "name": "payshield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "analytics:audit": "node scripts/analytics-audit.mjs",
    "analytics:evidence:check": "node scripts/check-analytics-evidence.mjs",
    "build": "next build",
    "campaign:lint": "node scripts/check-campaign-copy.mjs",
    "campaign:lint:all": "node scripts/check-campaign-manifest.mjs",
    "counsel:signoff:check": "node scripts/check-counsel-signoff.mjs",
    "legal:lint": "npm run campaign:lint -- docs/legal-review-packet.md docs/campaign-copy.md",
    "launch:evidence": "node scripts/launch-evidence.mjs",
    "lead-capture:dry-run": "node scripts/lead-capture-dry-run.mjs",
    "market:evidence:init": "node scripts/market-evidence-init.mjs",
    "market:go-no-go": "node scripts/market-go-no-go.mjs",
    "market:status": "node scripts/market-status.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "market-preflight": "node scripts/market-preflight.mjs",
    "readiness:paid-traffic": "node scripts/paid-traffic-readiness.mjs",
    "receiver:compose:config": "PAYSHIELD_WAITLIST_WEBHOOK_SECRET=compose-check PAYSHIELD_RECEIVER_HOST_DATA_DIR=/tmp/payshield-waitlist docker compose --env-file .env.receiver.example -f compose.receiver.yml config >/dev/null",
    "receiver:docker:build": "docker build -f Dockerfile.receiver -t payshield-waitlist-receiver:ci .",
    "receiver:docker:smoke": "node scripts/smoke-docker-receiver.mjs",
    "receiver:evidence": "node scripts/receiver-evidence.mjs",
    "receiver:blob:evidence": "node scripts/blob-receiver-evidence.mjs",
    "receiver:blob:check": "node scripts/check-blob-receiver-evidence.mjs",
    "receiver:managed:check": "node scripts/check-managed-receiver-evidence.mjs",
    "receiver:upstash:evidence": "node scripts/upstash-receiver-evidence.mjs",
    "receiver:upstash:check": "node scripts/check-upstash-receiver-evidence.mjs",
    "smoke:deploy": "node scripts/smoke-deploy.mjs",
    "vercel:upstash:cutover": "node scripts/vercel-upstash-cutover.mjs",
    "vercel:webhook:cutover": "node scripts/vercel-webhook-cutover.mjs",
    "waitlist:data": "node scripts/waitlist-data-ops.mjs",
    "vercel:env:audit": "node scripts/vercel-env-audit.mjs",
    "webhook:receive": "node scripts/waitlist-webhook-receiver.mjs",
    "webhook:test": "node scripts/test-waitlist-webhook.mjs",
    "test": "NODE_ENV=test VERCEL_WEB_ANALYTICS_DISABLE_LOGS=1 node --test tests/*.test.mts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run analytics:audit && npm run campaign:lint:all && npm run legal:lint && npm run market-preflight && npm run build && npm audit --omit=dev"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.4.0",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
