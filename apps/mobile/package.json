{
  "name": "@payshield/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@clerk/expo": "^4.4.0",
    "@expo/ui": "~57.0.14",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.17",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.8",
    "expo-local-authentication": "~57.0.2",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.31.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-plaid-link-sdk": "^13.0.4",
    "react-native-purchases": "^10.7.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --clear",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "npx --yes expo-doctor",
    "prebuild": "expo prebuild",
    "build:ios": "npx --yes eas-cli build --platform ios --profile production",
    "build:android": "npx --yes eas-cli build --platform android --profile production",
    "submit:ios": "npx --yes eas-cli submit --platform ios --profile production",
    "submit:android": "npx --yes eas-cli submit --platform android --profile production",
    "store:screenshots": "node scripts/capture-store-screenshots.mjs",
    "store:metadata:ios": "fastlane ios metadata",
    "store:metadata:android": "fastlane android metadata",
    "release:preflight": "node scripts/release-preflight.mjs",
    "postinstall": "node scripts/patch-image-size.mjs",
    "security:verify": "node scripts/patch-image-size.mjs --verify",
    "security:audit": "node scripts/audit-allowlist.mjs",
    "verify": "npm run security:verify && npm run security:audit && npm run lint && npm run typecheck && npm run doctor && npm run export:web"
  },
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@solana-mobile/mobile-wallet-adapter-protocol",
          "react-native-plaid-link-sdk"
        ]
      }
    }
  },
  "overrides": {
    "jayson": {
      "uuid": "11.1.1"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "private": true
}
