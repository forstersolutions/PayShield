# Copy this file to .env.receiver on the receiver host.
# Do not commit .env.receiver or real webhook secrets.

# Required. Use a long random value and set the same value in Vercel Production
# as PAYSHIELD_WAITLIST_WEBHOOK_SECRET.
PAYSHIELD_WAITLIST_WEBHOOK_SECRET=

# Required. Persistent host directory mounted into the receiver container at
# /data/waitlist. Keep it outside git and restrict host access.
PAYSHIELD_RECEIVER_HOST_DATA_DIR=/srv/payshield/waitlist

# Optional. Host port published to the container's internal port 8787.
PAYSHIELD_RECEIVER_HOST_PORT=8787

# Optional. Operator-owned protected backup directory used by waitlist:data
# backup/verify-backup commands.
PAYSHIELD_RECEIVER_BACKUP_DIR=/srv/payshield/waitlist-backups
