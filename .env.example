# Optional production URL used for metadata, sitemap, and robots output.
NEXT_PUBLIC_SITE_URL=https://payshield.vercel.app

# Optional. When set, /api/waitlist forwards pilot requests to this URL.
# Works with Make, Zapier, Airtable automations, Slack workflows, or a CRM webhook.
PAYSHIELD_WAITLIST_WEBHOOK_URL=

# Optional shared secret used to sign webhook bodies with HMAC-SHA256.
# The raw secret is not sent to the receiving endpoint.
PAYSHIELD_WAITLIST_WEBHOOK_SECRET=

# Optional. Set to true before paid traffic so valid submissions fail closed
# unless PAYSHIELD_WAITLIST_WEBHOOK_URL and PAYSHIELD_WAITLIST_WEBHOOK_SECRET
# are configured and accepting leads.
PAYSHIELD_REQUIRE_WAITLIST_WEBHOOK=false
