# Optional production URL used for metadata, sitemap, and robots output.
NEXT_PUBLIC_SITE_URL=https://payshield.vercel.app

# Public product/support destination for Grayston Technologies.
PAYSHIELD_SUPPORT_EMAIL=support@graystontechnologies.com

# Optional Clerk authentication. When both are configured, /app and /api/app/*
# are protected by Clerk sessions. Without these keys, local/demo verification
# uses the built-in private household profile.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Dedicated regulated core backend. This backend owns ledger, reconciliation,
# provider webhook, and card authorization operations when live money is enabled.
PAYSHIELD_CORE_API_URL=
PAYSHIELD_CORE_PORT=8080
PAYSHIELD_CORE_SERVICE_TOKEN=
PAYSHIELD_CORE_TIMEOUT_MS=8000
PAYSHIELD_LEDGER_DATABASE_URL=

# Regulated activation gates. Keep PAYSHIELD_LIVE_MONEY_ENABLED=false until the
# BaaS/card provider contract, credentials, sponsor disclosures, counsel
# sign-off, and operations runbooks are complete.
PAYSHIELD_LIVE_MONEY_ENABLED=false
PAYSHIELD_BAAS_PROVIDER=
PAYSHIELD_BAAS_API_KEY=
PAYSHIELD_BAAS_CONTRACT_APPROVED=false
PAYSHIELD_SPONSOR_DISCLOSURES_APPROVED=false
PAYSHIELD_REGULATED_COUNSEL_SIGNOFF=false
PAYSHIELD_OPERATIONS_RUNBOOKS_APPROVED=false

# Optional. When set, /api/waitlist forwards pilot requests to this URL.
# Works with Make, Zapier, Airtable automations, Slack workflows, or a CRM webhook.
PAYSHIELD_WAITLIST_WEBHOOK_URL=

# Optional shared secret used to sign webhook bodies with HMAC-SHA256.
# The raw secret is not sent to the receiving endpoint.
PAYSHIELD_WAITLIST_WEBHOOK_SECRET=

# Optional. Set to true before paid traffic so valid submissions fail closed
# unless PAYSHIELD_WAITLIST_WEBHOOK_URL and PAYSHIELD_WAITLIST_WEBHOOK_SECRET
# are configured and accepting leads.
PAYSHIELD_REQUIRE_WAITLIST_WEBHOOK=false

# Optional Vercel-native durable capture path. Set to blob after creating a
# private Vercel Blob store, or upstash after installing Upstash Redis through
# Vercel Marketplace and adding the REST env vars below.
PAYSHIELD_WAITLIST_STORAGE=
PAYSHIELD_WAITLIST_STORAGE_PREFIX=payshield:waitlist
BLOB_READ_WRITE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional when running the lightweight signed receiver.
PAYSHIELD_RECEIVER_PATH=/payshield-waitlist
PAYSHIELD_RECEIVER_HEALTH_PATH=/health
PAYSHIELD_RECEIVER_DATA_DIR=data/waitlist
